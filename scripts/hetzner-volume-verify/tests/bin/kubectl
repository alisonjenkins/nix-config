#!/usr/bin/env bash
# Fixture-driven kubectl: answers from files in $FIXTURES, never touches a cluster.
# Mutating verbs (patch, delete) are only logged to $FIXTURES/kubectl.calls.
set -euo pipefail
args="$*"
echo "$args" >> "$FIXTURES/kubectl.calls"
case "$args" in
  *"get secret"*) [ -f "$FIXTURES/secret.b64" ] || { echo "Error from server (NotFound)" >&2; exit 1; }; cat "$FIXTURES/secret.b64" ;;
  exec*) pod="$4"; db=$(sed -E 's/.* -d ([^ ]+).*/\1/' <<<"$args")
         if [ -f "$FIXTURES/psql-$pod-$db.txt" ]; then cat "$FIXTURES/psql-$pod-$db.txt"; else cat "$FIXTURES/psql-$pod.txt"; fi ;;
  *"get deployment "*|*"get statefulset "*)
         kind=$(sed -E 's/.*get (deployment|statefulset) .*/\1/' <<<"$args"); name=$(sed -E 's/.*get (deployment|statefulset) ([^ ]+).*/\2/' <<<"$args")
         [ -f "$FIXTURES/replicas-$kind-$name" ] || { echo "Error from server (NotFound): $kind $name" >&2; exit 1; }; cat "$FIXTURES/replicas-$kind-$name" ;;
  *"get job "*) [ -f "$FIXTURES/job.status" ] || { echo "Error from server (NotFound): job" >&2; exit 1; }; cat "$FIXTURES/job.status" ;;
  "apply "*) cat > "$FIXTURES/applied.yaml"; [ ! -f "$FIXTURES/job.result" ] || cp "$FIXTURES/job.result" "$FIXTURES/job.status" ;;
  "logs "*job/*) cat "$FIXTURES/job.logs" ;;
  *"get pods"*) cat "$FIXTURES/pods.json" ;;
  logs*) [ ! -f "$FIXTURES/logs.fail" ] || { echo "error: you are attempting to follow too many log streams" >&2; exit 1; }
         cat "$FIXTURES/logs.txt" 2>/dev/null || true ;;
  *"get storageclass"*) cat "$FIXTURES/sc.ref" ;;
  *"get backups.velero.io"*|*"get backups.postgresql.cnpg.io"*) cat "$FIXTURES/backups.json" ;;
  *"get pvc "*) [ -f "$FIXTURES/pvcs.json" ] || { echo "Error from server (NotFound): namespace" >&2; exit 1; }; cat "$FIXTURES/pvcs.json" ;;
  *"get pv "*claimRef*) pv=$(sed -E 's/.*get pv ([^ ]+).*/\1/' <<<"$args"); [ -f "$FIXTURES/pv-$pv.claimref" ] || { echo "Error from server (NotFound): pv $pv" >&2; exit 1; }; cat "$FIXTURES/pv-$pv.claimref" ;;
  *"get pv "*storageClassName*) pv=$(sed -E 's/.*get pv ([^ ]+).*/\1/' <<<"$args"); [ -f "$FIXTURES/pv-$pv.class" ] || { echo "Error from server (NotFound): pv $pv" >&2; exit 1; }; cat "$FIXTURES/pv-$pv.class" ;;
  *"get pv "*) pv=$(sed -E 's/.*get pv ([^ ]+).*/\1/' <<<"$args"); [ -f "$FIXTURES/pv-$pv.policy" ] || { echo "Error from server (NotFound): pv $pv" >&2; exit 1; }; cat "$FIXTURES/pv-$pv.policy" ;;
  "patch pv "*) pv=$(awk '{print $3}' <<<"$args"); echo Retain > "$FIXTURES/pv-$pv.policy" ;;
  patch*|delete*) ;;
  *) echo "fake kubectl: unhandled: $args" >&2; exit 99 ;;
esac
