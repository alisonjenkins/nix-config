{
  "uid": "token-cost",
  "title": "Token cost",
  "tags": [
    "observability-stack"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "utc",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total tokens (range)",
      "description": "Total tokens used over the dashboard range, all types, label review runs excluded. Metric name claude_code_token_usage_tokens_total and its labels: name unverified against a live export.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_token_usage_tokens_total{review_run!=\"1\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Estimated cost (range, USD)",
      "description": "Estimated cost over the range. Metric claude_code_cost_usage_USD_total: name unverified (matched by regex claude_code_cost_usage.*). Unavailable until cost is collected.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(increase({__name__=~\"claude_code_cost_usage.*\",review_run!=\"1\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens per hour, current vs previous period",
      "description": "Tokens per hour, review runs excluded. Set the Compare variable to 'previous period' to add a series shifted back 7d (offset 7d, matching the default 7d range; edit if you change the range). Metric name claude_code_token_usage_tokens_total and its labels: name unverified against a live export.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_token_usage_tokens_total{review_run!=\"1\"}[1h]))",
          "legendFormat": "current",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(increase(claude_code_token_usage_tokens_total{review_run!=\"1\"}[1h] offset 7d)) * $compare > 0",
          "legendFormat": "previous period (offset 7d)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Tokens by model",
      "description": "Tokens over the range grouped by model, sum by model. Set the Compare variable to 'previous period' to add a series shifted back 7d (offset 7d, matching the default 7d range; edit if you change the range). Metric name claude_code_token_usage_tokens_total and its labels: name unverified against a live export.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_token_usage_tokens_total{review_run!=\"1\"}[$__range]))",
          "legendFormat": "{{model}}",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (model) (increase(claude_code_token_usage_tokens_total{review_run!=\"1\"}[$__range] offset 7d)) * $compare > 0",
          "legendFormat": "prev {{model}}",
          "instant": true,
          "range": false,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "showLegend": true
        }
      }
    },
