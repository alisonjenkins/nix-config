    {
      "id": 12,
      "type": "barchart",
      "title": "Top tools by result bytes",
      "description": "Tools whose results injected the most bytes over the range, from ledger tool_call log records. Unavailable until cc-obs-ledger turn has shipped tool_call records. Fields event_name, tool_name, result_bytes: name unverified.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "topk(15, sum by (tool_name) (sum_over_time({service_name=\"cc-obs-ledger\"} | event_name=\"cc_obs_ledger.tool_call\" | unwrap result_bytes [$__range])))",
          "legendFormat": "{{tool_name}}",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
