    {
      "id": 11,
      "type": "timeseries",
      "title": "Cache read vs cache creation vs input",
      "description": "Token type split over time (cacheRead, cacheCreation, input, output). A large cacheRead share is good. Label type and its values: name unverified. Metric name claude_code_token_usage_tokens_total and its labels: name unverified against a live export.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
