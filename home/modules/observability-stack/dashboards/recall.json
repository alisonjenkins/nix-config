{
  "uid": "recall",
  "title": "Memory and skill recall",
  "tags": [
    "observability-stack"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "utc",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Recall requests by outcome",
      "description": "Requests per hour by service and outcome (hit, miss, error, ...). Metric recall_requests_total{service,outcome}; outcome values: name unverified against a live export.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service, outcome) (increase(recall_requests_total[1h]))",
          "legendFormat": "{{service}} {{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Hit rate",
      "description": "recall_hits_total divided by recall_requests_total per service; higher is better. Unavailable until the recall hooks export metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (increase(recall_hits_total[1h])) / sum by (service) (increase(recall_requests_total[1h]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Recall latency p50 / p95",
      "description": "Quantile of per-run recall latency over the last 15 minutes. recall_latency_seconds is a gauge holding the latest run's latency, so this shows the p50 and p95 of those values, not a histogram quantile.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (service) (quantile_over_time(0.5, recall_latency_seconds[15m]))",
          "legendFormat": "p50 {{service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max by (service) (quantile_over_time(0.95, recall_latency_seconds[15m]))",
          "legendFormat": "p95 {{service}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tokens injected per day",
      "description": "Tokens added to context by recall per day, the cost of recall. Metric recall_tokens_injected_total; unavailable until collected.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (increase(recall_tokens_injected_total[1d]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "table",
      "title": "Failure causes",
      "description": "Recall runs that did not succeed, grouped by service, outcome and cause from the recall log. Fields outcome and cause: name unverified; unavailable until recall logs are shipped.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service_name, outcome, cause) (count_over_time({service_name=~\"memory-recall|skill-recall\"} | json | outcome=\"error\" | cause!=\"\" [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Recall log (session_id links to trace)",
      "description": "Recent recall log lines. The session_id field carries a data link to a Tempo trace search; field session_id: name unverified (spans may carry session.id under a different attribute).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{service_name=~\"memory-recall|skill-recall\"} | json",
          "legendFormat": "__auto",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open trace for session",
              "url": "/explore?left={\"datasets\":null,\"datasource\":\"tempo\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"tempo\"},\"queryType\":\"traceql\",\"query\":\"{ span.session.id = \\\"${__value.raw}\\\" }\"}]}",
              "targetBlank": true
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "session_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace for session",
                    "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"tempo\"},\"queryType\":\"traceql\",\"query\":\"{ span.session.id = \\\"${__value.raw}\\\" }\"}]}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showLabels": true,
        "enableLogDetails": true,
        "wrapLogMessage": true
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": []
}
