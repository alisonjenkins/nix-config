{
  "uid": "claude-code",
  "title": "Claude Code activity",
  "tags": [
    "observability-stack"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "utc",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sessions (range)",
      "description": "Sessions started over the range. Metric claude_code_session_count_total: name unverified; unavailable until collected.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_session_count_total{review_run!=\"1\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active time (range)",
      "description": "Active time over the range. Metric claude_code_active_time_seconds_total: name unverified; unavailable until collected.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_active_time_seconds_total{review_run!=\"1\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API errors (range)",
      "description": "Count of api_error events in the range. Loki event_name=api_error: name unverified; unavailable until Claude Code logs are exported.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | event_name=\"api_error\" [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Compactions (range)",
      "description": "Compaction events in the range, matched by event_name regex .*compact.*: name unverified; unavailable until emitted.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | event_name=~\".*compact.*\" [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sessions per day",
      "description": "Session starts per day. Metric name unverified.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_session_count_total{review_run!=\"1\"}[1d]))",
          "legendFormat": "sessions",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Active time per day",
      "description": "Active seconds per day by type. Metric claude_code_active_time_seconds_total and label type: name unverified.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (type) (increase(claude_code_active_time_seconds_total{review_run!=\"1\"}[1d]))",
          "legendFormat": "{{type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tool call latency p50 / p95",
      "description": "Median and 95th percentile tool duration by tool. Fields event_name=tool_result, duration_ms, tool_name: name unverified; unavailable until tool_result logs are exported.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.5, {service_name=\"claude-code\"} | event_name=\"tool_result\" | unwrap duration_ms [5m]) by (tool_name)",
          "legendFormat": "p50 {{tool_name}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=\"tool_result\" | unwrap duration_ms [5m]) by (tool_name)",
          "legendFormat": "p95 {{tool_name}}",
          "queryType": "range",
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tool error rate",
      "description": "Share of tool_result events with success=false, per tool. Field success: name unverified; unavailable until tool_result logs are exported.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (tool_name) (rate({service_name=\"claude-code\"} | event_name=\"tool_result\" | success=\"false\" [5m])) / sum by (tool_name) (rate({service_name=\"claude-code\"} | event_name=\"tool_result\" [5m]))",
          "legendFormat": "{{tool_name}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "API errors over time",
      "description": "api_error events per 15 minutes by status code. Field status_code: name unverified.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (status_code) (count_over_time({service_name=\"claude-code\"} | event_name=\"api_error\" [15m]))",
          "legendFormat": "{{status_code}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Token trend per day",
      "description": "Tokens per day by type. Metric claude_code_token_usage_tokens_total: name unverified.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (type) (increase(claude_code_token_usage_tokens_total{review_run!=\"1\"}[1d]))",
          "legendFormat": "{{type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cost trend per day (USD)",
      "description": "Estimated cost per day. Metric claude_code_cost_usage_USD_total (regex claude_code_cost_usage.*): name unverified; unavailable until collected.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(increase({__name__=~\"claude_code_cost_usage.*\",review_run!=\"1\"}[1d]))",
          "legendFormat": "cost",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Compactions over time",
      "description": "Compaction events per hour; frequent compactions mean sessions run too long. Event name: name unverified; unavailable until emitted.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | event_name=~\".*compact.*\" [1h]))",
          "legendFormat": "compactions",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Hook execution time",
      "description": "Hook run duration p95 by hook. Event name hook* and fields duration_ms, hook_name: name unverified; unavailable until emitted (may need trace spans instead).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=~\"hook.*\" | unwrap duration_ms [15m]) by (hook_name)",
          "legendFormat": "p95 {{hook_name}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "traces",
      "title": "Recent Claude Code traces",
      "description": "Recent traces from Tempo for service claude-code; tool latency can also be read from spans. Unavailable until traces are exported (Claude Code traces are beta); service name: name unverified.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"claude-code\" }",
          "limit": 20,
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": []
}
