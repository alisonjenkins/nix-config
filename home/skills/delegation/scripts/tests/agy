#!/usr/bin/env bash
# Stand-in for the real `agy` CLI, driven by FAKE_AGY_MODE, so tests don't hit
# the Google API. Records each call's args to FAKE_AGY_CALLS (one per line,
# tab-separated) and emits scripted output and exit codes per mode. With
# --output-format json it prints the same envelope shape as the real CLI.
set -euo pipefail

task=""
model=""
mode=""
effort=""
format="text"
skip_perms="no"
add_dirs=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p) task="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    --mode) mode="$2"; shift 2 ;;
    --effort) effort="$2"; shift 2 ;;
    --output-format) format="$2"; shift 2 ;;
    --print-timeout) shift 2 ;;
    --dangerously-skip-permissions) skip_perms="yes"; shift ;;
    --add-dir) add_dirs+=("$2"); shift 2 ;;
    *) echo "fake-agy: unexpected arg: $1" >&2; exit 2 ;;
  esac
done

if [[ -n "${FAKE_AGY_CALLS:-}" ]]; then
  add_dir_joined="$(IFS=,; echo "${add_dirs[*]:-}")"
  printf 'task=%s\tmodel=%s\tmode=%s\tskip_perms=%s\teffort=%s\tadd_dir=%s\tformat=%s\ttraceparent=%s\tssh_connection=%s\n' \
    "$task" "$model" "$mode" "$skip_perms" "$effort" "$add_dir_joined" "$format" "${TRACEPARENT:-}" "${SSH_CONNECTION:-}" >>"$FAKE_AGY_CALLS"
fi

# One finished turn: the answer, plus the envelope when JSON was asked for.
emit_answer() {
  local denied="${1:-}" text="response for model=$model: $task"
  if [[ "$format" == "json" ]]; then
    if [[ -n "$denied" ]]; then
      jq -n -c '{conversation_id: "fake-conv", status: "SUCCESS", response: "", duration_seconds: 1.5, num_turns: 1,
        usage: {input_tokens: 100, output_tokens: 20, thinking_tokens: 5, cache_read_tokens: 7, total_tokens: 120},
        denied_actions: [{action: $a, display_name: "Fake"}]}' --arg a "$denied"
    else
      jq -n -c --arg r "$text" '{conversation_id: "fake-conv", status: "SUCCESS", response: $r, duration_seconds: 1.5, num_turns: 1,
        usage: {input_tokens: 100, output_tokens: 20, thinking_tokens: 5, cache_read_tokens: 7, total_tokens: 120}}'
    fi
  elif [[ -z "$denied" ]]; then
    echo "$text"
  fi
}

case "${FAKE_AGY_MODE:-ok}" in
  ok)
    emit_answer
    ;;
  flash-medium-rejected)
    if [[ "$model" == "gemini-3.8-flash-medium" ]]; then
      echo "error: invalid model selection (--model \"$model\" --effort \"\"): model $model is not recognized as a known model or custom model in settings" >&2
      exit 1
    fi
    emit_answer
    ;;
  soft-denied-command)
    echo "jetski: no output produced — a tool required the \"command\" permission that headless mode cannot prompt for, so it was auto-denied." >&2
    emit_answer command
    ;;
  soft-denied-write)
    echo "jetski: no output produced — a tool required the \"write_file\" permission that headless mode cannot prompt for, so it was auto-denied." >&2
    emit_answer write_file
    ;;
  json-error)
    # What agy 1.2.9 really does for a bad model: the envelope on stdout and
    # the same message on stderr, exit 1.
    msg="invalid model selection (--model \"$model\" --effort \"\"): model $model is not recognized as a known model or custom model in settings"
    if [[ "$format" == "json" ]]; then
      jq -n -c --arg e "$msg" '{conversation_id: "", status: "ERROR", response: "", error: $e, duration_seconds: 0, num_turns: 0,
        usage: {input_tokens: 0, output_tokens: 0, thinking_tokens: 0, cache_read_tokens: 0, total_tokens: 0}}'
    fi
    echo "error: $msg" >&2
    exit 1
    ;;
  bad-effort)
    echo "error: invalid model selection (--model \"$model\" --effort \"xhigh\"): invalid --effort \"xhigh\" (valid: low, medium, high)" >&2
    exit 1
    ;;
  unauthenticated)
    echo "authentication required" >&2
    exit 1
    ;;
  unrelated-failure)
    echo "Error: something else went wrong" >&2
    exit 1
    ;;
  outage-persistent)
    echo "Error: network error: connection reset by peer" >&2
    exit 1
    ;;
  quota-exhausted)
    echo "RESOURCE_EXHAUSTED: usage limit reached" >&2
    exit 1
    ;;
  *)
    echo "fake-agy: unknown FAKE_AGY_MODE" >&2
    exit 2
    ;;
esac
