#!/usr/bin/env bash
# Stand-in for the real `copilot` CLI, driven by FAKE_COPILOT_MODE, so tests
# don't hit the paid external API. Records the args it was called with to
# FAKE_COPILOT_CALLS (one call per line, tab-separated fields) and emits
# scripted stdout/stderr/exit codes per mode.
set -euo pipefail

task=""
model=""
allow_tool=""
silent="no"
no_ask_user="no"
add_dirs=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p) task="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    -s) silent="yes"; shift ;;
    --no-ask-user) no_ask_user="yes"; shift ;;
    --allow-tool=*) allow_tool="${1#--allow-tool=}"; shift ;;
    --add-dir) add_dirs+=("$2"); shift 2 ;;
    *) echo "fake-copilot: unexpected arg: $1" >&2; exit 2 ;;
  esac
done

if [[ -n "${FAKE_COPILOT_CALLS:-}" ]]; then
  add_dir_joined="$(IFS=,; echo "${add_dirs[*]:-}")"
  printf 'task=%s\tmodel=%s\tsilent=%s\tno_ask_user=%s\tallow_tool=%s\tadd_dir=%s\tgh_host=%s\tcopilot_gh_host=%s\n' \
    "$task" "$model" "$silent" "$no_ask_user" "$allow_tool" "$add_dir_joined" \
    "${GH_HOST:-}" "${COPILOT_GH_HOST:-}" >>"$FAKE_COPILOT_CALLS"
fi

# Lets tests prove a granted --add-dir is actually usable *during* the
# real CLI's lifetime, before delegate.sh's cleanup trap removes any
# staged copy on exit. FAKE_COPILOT_CAT_RELATIVE is a path relative to
# the last --add-dir; its content, if found under any granted dir, is
# recorded so the test can assert on it after the run.
if [[ -n "${FAKE_COPILOT_CAT_RELATIVE:-}" && -n "${FAKE_COPILOT_CAT_OUT:-}" ]]; then
  for dir in "${add_dirs[@]}"; do
    if [[ -f "$dir/$FAKE_COPILOT_CAT_RELATIVE" ]]; then
      cat "$dir/$FAKE_COPILOT_CAT_RELATIVE" >"$FAKE_COPILOT_CAT_OUT"
      break
    fi
  done
fi

case "${FAKE_COPILOT_MODE:-all-models-ok}" in
  all-models-ok)
    echo "response for model=$model: $task"
    ;;
  luna-rejected)
    if [[ "$model" == "gpt-5.6-luna" ]]; then
      echo "Error: Model \"$model\" from --model flag is not available." >&2
      exit 1
    fi
    echo "response for model=$model: $task"
    ;;
  unrelated-failure)
    echo "Error: something else went wrong" >&2
    exit 1
    ;;
  phrase-collision)
    echo "Error: the requested feature is not available on this plan." >&2
    exit 1
    ;;
  outage-persistent)
    echo "Error: network error: connection reset by peer" >&2
    exit 1
    ;;
  outage-503)
    echo "Error: HTTP 503 Service Unavailable" >&2
    exit 1
    ;;
  outage-then-ok)
    count_file="${FAKE_COPILOT_OUTAGE_COUNTER:?FAKE_COPILOT_OUTAGE_COUNTER required for outage-then-ok}"
    n=0
    [[ -f "$count_file" ]] && n="$(<"$count_file")"
    n=$((n + 1))
    echo "$n" >"$count_file"
    if (( n < "${FAKE_COPILOT_OUTAGE_SUCCEED_ON:-2}" )); then
      echo "Error: network error: connection timed out" >&2
      exit 1
    fi
    echo "response for model=$model: $task"
    ;;
  credits-exhausted)
    echo "Error: You have exceeded your premium request quota for this billing period." >&2
    exit 1
    ;;
  *)
    echo "fake-copilot: unknown FAKE_COPILOT_MODE" >&2
    exit 2
    ;;
esac
