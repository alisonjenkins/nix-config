#!/usr/bin/env bash
# Fake `curl` test double for delegate-to-local.bats. Logs each call to
# $FAKE_CURL_CALLS and fabricates responses based on $FAKE_CURL_UP (a
# comma-separated list of base URLs that are "up") and $FAKE_CURL_MODE.
set -euo pipefail

calls_log="${FAKE_CURL_CALLS:?FAKE_CURL_CALLS must be set}"

url=""
method="GET"
max_time=""
body=""
args=("$@")
i=0
while [[ $i -lt ${#args[@]} ]]; do
  arg="${args[$i]}"
  case "$arg" in
    -X)
      method="${args[$((i + 1))]}"
      i=$((i + 2))
      ;;
    -d)
      body="${args[$((i + 1))]}"
      i=$((i + 2))
      ;;
    --max-time)
      max_time="${args[$((i + 1))]}"
      i=$((i + 2))
      ;;
    -H)
      i=$((i + 2))
      ;;
    http*)
      url="$arg"
      i=$((i + 1))
      ;;
    *)
      i=$((i + 1))
      ;;
  esac
done

printf 'url=%s\tmethod=%s\tmax_time=%s\tbody=%s\n' "$url" "$method" "$max_time" "$body" >>"$calls_log"

base="${url%/health}"
base="${base%/v1/models}"
base="${base%/v1/chat/completions}"
up_list="${FAKE_CURL_UP:-}"
is_up=0
IFS=',' read -ra up_arr <<<"$up_list"
for u in "${up_arr[@]}"; do
  if [[ "$u" == "$base" ]]; then
    is_up=1
    break
  fi
done

if [[ "$is_up" -eq 0 ]]; then
  echo "curl: (7) Failed to connect to $base" >&2
  exit 7
fi

if [[ "$method" == "GET" && "$url" == */health ]]; then
  case "${FAKE_CURL_MODE:-}" in
    health-ok)
      echo '{"status":"ok"}'
      exit 0
      ;;
    health-loading)
      echo '{"status":"loading"}'
      exit 0
      ;;
    health-loading-then-ok)
      counter_file="${FAKE_CURL_HEALTH_COUNTER:?FAKE_CURL_HEALTH_COUNTER must be set}"
      ok_on="${FAKE_CURL_HEALTH_OK_ON:?FAKE_CURL_HEALTH_OK_ON must be set}"
      count="$(($(cat "$counter_file" 2>/dev/null || echo 0) + 1))"
      echo "$count" >"$counter_file"
      if ((count >= ok_on)); then
        echo '{"status":"ok"}'
      else
        echo '{"status":"loading"}'
      fi
      exit 0
      ;;
    *)
      # No /health route on this fake backend by default — matches
      # curl -f's behavior on a real 404: nonzero exit, no output.
      exit 22
      ;;
  esac
fi

if [[ "$method" == "GET" ]]; then
  if [[ "${FAKE_CURL_MODE:-}" == "malformed-models" ]]; then
    echo "not json"
    exit 0
  fi
  port="${base##*:}"
  printf '{"data":[{"id":"fake-model-%s"}]}\n' "$port"
  exit 0
fi

# POST /v1/chat/completions
if [[ "${FAKE_CURL_MODE:-}" == "chat-error" ]]; then
  echo '{"error":"boom"}'
  exit 22
fi

# A timeout/connection failure has no HTTP response at all — curl reports
# it on stderr with nothing on stdout, unlike chat-error above (which
# simulates an HTTP-level error --fail-with-body still captures a body
# for). Exit 28 matches curl's own "Operation timed out" code.
if [[ "${FAKE_CURL_MODE:-}" == "chat-timeout" ]]; then
  echo "curl: (28) Operation timed out" >&2
  exit 28
fi

if [[ "${FAKE_CURL_MODE:-}" == "chat-loading-then-ok" ]]; then
  counter_file="${FAKE_CURL_CHAT_COUNTER:?FAKE_CURL_CHAT_COUNTER must be set}"
  ok_on="${FAKE_CURL_CHAT_OK_ON:?FAKE_CURL_CHAT_OK_ON must be set}"
  count="$(($(cat "$counter_file" 2>/dev/null || echo 0) + 1))"
  echo "$count" >"$counter_file"
  if ((count < ok_on)); then
    echo '{"error":{"message":"Loading model","type":"unavailable_error","code":503}}'
    exit 22
  fi
fi

model_field="$(jq -r '.model' <<<"$body")"
task_content="$(jq -r '.messages[0].content' <<<"$body")"
jq -n --arg c "response for model=$model_field: $task_content" '{choices: [{message: {content: $c}}]}'
