#!/usr/bin/env bash
# Stand-in for the `gh` CLI, driven by fixture files under FAKE_GH_FIXTURES,
# so poll-pr-review.sh's tests don't hit the network. Recognizes exactly the
# calls the script makes and returns canned output for each.
set -euo pipefail

fixtures="${FAKE_GH_FIXTURES:?FAKE_GH_FIXTURES must point at a fixture dir}"

args=("$@")

is_graphql_threads=0
is_graphql_reply=0
is_graphql_status=0
is_reviews_list=0
is_pr_view=0
is_pr_view_title=0
is_pr_view_body=0
is_pr_view_fingerprint=0
is_pr_checks=0
is_pr_edit=0

for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[$i]}" in
    graphql) is_graphql_threads=1 ;;
    */pulls/*/reviews) is_reviews_list=1 ;;
  esac
  if [[ "${args[$i]}" == "-f" && "${args[$((i + 1))]:-}" == query=* ]]; then
    case "${args[$((i + 1))]}" in
      *addPullRequestReviewThreadReply*)
        is_graphql_threads=0
        is_graphql_reply=1
        ;;
      *statusCheckRollup*)
        is_graphql_threads=0
        is_graphql_status=1
        ;;
    esac
  fi
done

if [[ "${args[0]:-}" == "pr" && "${args[1]:-}" == "view" ]]; then
  is_pr_view=1
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ "${args[$i]}" == "--json" ]]; then
      case "${args[$((i + 1))]:-}" in
        title) is_pr_view_title=1 ;;
        body) is_pr_view_body=1 ;;
      esac
      if [[ "${args[$((i + 1))]:-}" == *reviewDecision* && "${args[$((i + 1))]:-}" == *updatedAt* ]]; then
        is_pr_view_fingerprint=1
      fi
    fi
  done
elif [[ "${args[0]:-}" == "pr" && "${args[1]:-}" == "checks" ]]; then
  is_pr_checks=1
elif [[ "${args[0]:-}" == "pr" && "${args[1]:-}" == "edit" ]]; then
  is_pr_edit=1
fi

if [[ $is_graphql_status -eq 1 ]]; then
  if [[ -f "$fixtures/graphql-status-fails" ]]; then
    echo "fake-gh: simulated GraphQL failure (auth/network)" >&2
    exit 1
  fi
  has_after=0
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ "${args[$i]}" == "-F" && "${args[$((i + 1))]:-}" == after=* ]]; then
      has_after=1
    fi
  done
  if [[ $has_after -eq 1 && -f "$fixtures/pr-status-page2.json" ]]; then
    cat "$fixtures/pr-status-page2.json"
  else
    cat "$fixtures/pr-status.json"
  fi
elif [[ $is_graphql_reply -eq 1 ]]; then
  printf '%s\n' "${args[@]}" >"$fixtures/graphql-reply-capture.txt"
  if [[ -f "$fixtures/graphql-reply-fails" ]]; then
    echo "fake-gh: simulated GraphQL failure (auth/network)" >&2
    exit 1
  elif [[ -f "$fixtures/graphql-reply-partial-errors" ]]; then
    echo '{"data":{"r0":null},"errors":[{"message":"simulated partial failure"}]}'
  else
    echo '{"data":{}}'
  fi
elif [[ $is_graphql_threads -eq 1 ]]; then
  if [[ -f "$fixtures/graphql-fails" ]]; then
    echo "fake-gh: simulated GraphQL failure (auth/network)" >&2
    exit 1
  fi
  has_after=0
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ "${args[$i]}" == "-F" && "${args[$((i + 1))]:-}" == after=* ]]; then
      has_after=1
    fi
  done
  if [[ -f "$fixtures/threads-page1.tsv" ]]; then
    if [[ $has_after -eq 1 ]]; then
      cat "$fixtures/threads-page2.tsv"
      printf '__PAGEINFO__\tfalse\t\n'
    else
      cat "$fixtures/threads-page1.tsv"
      printf '__PAGEINFO__\ttrue\tCURSOR1\n'
    fi
  elif [[ -f "$fixtures/no-pageinfo-sentinel" ]]; then
    cat "$fixtures/threads.tsv"
    # deliberately omit the __PAGEINFO__ row
  elif [[ -f "$fixtures/hasnext-empty-cursor" ]]; then
    cat "$fixtures/threads.tsv"
    printf '__PAGEINFO__\ttrue\t\n'
  else
    cat "$fixtures/threads.tsv"
    printf '__PAGEINFO__\tfalse\t\n'
  fi
elif [[ $is_reviews_list -eq 1 ]]; then
  if [[ -n "${FAKE_GH_COUNT_REVIEWS_CALLS:-}" ]]; then
    count_file="$fixtures/reviews-list-call-count"
    count="$(cat "$count_file" 2>/dev/null || echo 0)"
    echo "$((count + 1))" >"$count_file"
  fi
  # Default/convenience: review-bodies.txt's raw prose wrapped as one
  # review's body, with fixed submitted_at/user/commit_id so the verdict
  # line is predictable (an empty file's body is "", filtered out by the
  # script's own `select(.body != "")` for both suppressed scan and
  # verdict alike -- that's the "no reviews yet" case).
  # Full control when a test needs more than one review: reviews.json,
  # a fixture-authored JSON array, takes priority when present.
  if [[ -f "$fixtures/reviews.json" ]]; then
    cat "$fixtures/reviews.json"
  else
    jq -Rs '[{body: ., submitted_at: "2026-01-01T00:00:00Z",
      user: {login: "someone"}, commit_id: "abcdef1234567890"}]' \
      <"$fixtures/review-bodies.txt"
  fi
elif [[ $is_pr_view_title -eq 1 ]]; then
  if [[ -f "$fixtures/pr-view-fails" ]]; then
    echo "fake-gh: simulated gh pr view failure" >&2
    exit 1
  fi
  cat "$fixtures/pr-title.txt" 2>/dev/null || echo "Fixture PR title"
elif [[ $is_pr_view_body -eq 1 ]]; then
  if [[ -f "$fixtures/pr-view-fails" ]]; then
    echo "fake-gh: simulated gh pr view failure" >&2
    exit 1
  fi
  cat "$fixtures/pr-body.md" 2>/dev/null || printf 'Fixture PR body.\n'
elif [[ $is_pr_edit -eq 1 ]]; then
  if [[ -f "$fixtures/pr-edit-fails" ]]; then
    echo "fake-gh: simulated gh pr edit failure" >&2
    exit 1
  fi
  printf '%s\n' "${args[@]}" >"$fixtures/pr-edit-capture.txt"
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ "${args[$i]}" == "--body-file" ]]; then
      cp "${args[$((i + 1))]}" "$fixtures/pr-edit-body-file-capture.txt"
    fi
  done
elif [[ $is_pr_view_fingerprint -eq 1 ]]; then
  if [[ -f "$fixtures/fingerprint-fails" ]]; then
    echo "fake-gh: simulated gh pr view failure" >&2
    exit 1
  fi
  if [[ -f "$fixtures/fingerprint-stderr-noise" ]]; then
    echo "fake-gh: harmless stderr noise $RANDOM" >&2
  fi
  count_file="$fixtures/fingerprint-call-count"
  count="$(cat "$count_file" 2>/dev/null || echo 0)"
  count=$((count + 1))
  echo "$count" >"$count_file"
  if [[ -f "$fixtures/fingerprint-sequence.tsv" ]]; then
    line_count="$(wc -l <"$fixtures/fingerprint-sequence.tsv")"
    use_line=$((count > line_count ? line_count : count))
    sed -n "${use_line}p" "$fixtures/fingerprint-sequence.tsv"
  else
    printf 'OPEN\tnull\t2026-01-01T00:00:00Z\tMERGEABLE\tCLEAN\t0\n'
  fi
elif [[ $is_pr_view -eq 1 ]]; then
  if [[ -f "$fixtures/no-pr" ]]; then
    echo "fake-gh: no pull requests found for branch" >&2
    exit 1
  fi
  pr_number="$(cat "$fixtures/pr-number.txt" 2>/dev/null || echo 1)"
  pr_head_sha="$(cat "$fixtures/pr-head-sha.txt" 2>/dev/null || echo "")"
  printf '%s\t%s\n' "$pr_number" "$pr_head_sha"
elif [[ $is_pr_checks -eq 1 ]]; then
  if [[ -f "$fixtures/checks-no-checks" ]]; then
    echo "no checks reported on the branch" >&2
    exit 1
  elif [[ -f "$fixtures/checks-fail" ]]; then
    echo "some-check	fail	0	url"
    exit 1
  else
    echo "some-check	pass	0	url"
  fi
else
  echo "fake-gh: unrecognized invocation: ${args[*]}" >&2
  exit 2
fi
