#!/usr/bin/env bash
# Stand-in for the `gh` CLI, driven by fixture files under FAKE_GH_FIXTURES,
# so poll-pr-review.sh's tests don't hit the network. Recognizes exactly the
# calls the script makes and returns canned output for each.
set -euo pipefail

fixtures="${FAKE_GH_FIXTURES:?FAKE_GH_FIXTURES must point at a fixture dir}"

args=("$@")

is_graphql_threads=0
is_reviews_body_scan=0
is_reviews_verdict=0

for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[$i]}" in
    graphql) is_graphql_threads=1 ;;
  esac
  if [[ "${args[$i]}" == "--jq" ]]; then
    next="${args[$((i + 1))]:-}"
    # verdict's query also contains "select(.body" (inside a map()), so it
    # must be checked first — it's the more specific pattern.
    case "$next" in
      *"sort_by(.submitted_at)"*) is_reviews_verdict=1 ;;
      *"select(.body"*) is_reviews_body_scan=1 ;;
    esac
  fi
done

if [[ $is_graphql_threads -eq 1 ]]; then
  if [[ -f "$fixtures/graphql-fails" ]]; then
    echo "fake-gh: simulated GraphQL failure (auth/network)" >&2
    exit 1
  fi
  has_after=0
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ "${args[$i]}" == "-F" && "${args[$((i + 1))]:-}" == after=* ]]; then
      has_after=1
    fi
  done
  if [[ -f "$fixtures/threads-page1.tsv" ]]; then
    if [[ $has_after -eq 1 ]]; then
      cat "$fixtures/threads-page2.tsv"
      printf '__PAGEINFO__\tfalse\t\n'
    else
      cat "$fixtures/threads-page1.tsv"
      printf '__PAGEINFO__\ttrue\tCURSOR1\n'
    fi
  else
    cat "$fixtures/threads.tsv"
    printf '__PAGEINFO__\tfalse\t\n'
  fi
elif [[ $is_reviews_body_scan -eq 1 ]]; then
  cat "$fixtures/review-bodies.txt"
elif [[ $is_reviews_verdict -eq 1 ]]; then
  cat "$fixtures/verdict-line.txt"
else
  echo "fake-gh: unrecognized invocation: ${args[*]}" >&2
  exit 2
fi
