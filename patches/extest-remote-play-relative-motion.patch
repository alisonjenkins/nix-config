+// -- Persistent layout watcher, used only when EXTEST_TARGET_OUTPUT is set.
+// --
+//
+// Steam Remote Play's mouse input arrives as XTestFakeMotionEvent with
+// coordinates local to the client's own panel, which extest turns into
+// uinput ABS_X/ABS_Y. niri's libinput backend never maps an absolute
+// device to a specific output -- `NiriInputDevice::output` returns `None`
+// unconditionally for every `libinput::Device` (niri's own
+// `src/input/backend_ext.rs`, with its own `// FIXME: Allow specifying the
+// output per-device?`) -- so `on_pointer_motion_absolute` always falls
+// back to scaling the raw axis value across the bounding rectangle of
+// *every enabled output* and adding that rectangle's own top-left corner
+// (`compute_absolute_location(&event, None).or_else(|| { ... bbox ... })`
+// in niri's `src/input/mod.rs`). Calibrating extest's declared axis range
+// to the target output's own size -- an earlier version of this patch --
+// changes what *fraction* of the streamed area lands across the whole
+// desktop; it does not stop positions from landing outside the target
+// output, because libinput normalises the declared range away before
+// niri ever sees it (`absinfo_scale_axis` divides by the range). The only
+// way to land a position on a specific output is to compute that
+// output's actual place in the *whole* layout and emit already-global
+// coordinates -- which needs every output's position and size, not just
+// the target's.
+struct LayoutWatcherData {
+    output_man: Option<ZxdgOutputManagerV1>,
+    // A GlobalRemove event only gives the registry's numeric global name,
+    // not the wl_output object id -- this is the only way to find out
+    // which output that was. Outputs on this host really do come and go:
+    // the target virtual output is toggled on/off between Remote Play
+    // sessions, which niri implements as adding/removing the wl_output
+    // global outright, not just resizing it.
+    names_by_global: HashMap<u32, ObjectId>,
+    output_names: HashMap<ObjectId, String>,
+    geometries: HashMap<ObjectId, Rect>,
+    pending_outputs: Vec<(u32, wl_output::WlOutput)>,
+    target_name: String,
+    last_reported: Option<LayoutUpdate>,
+    on_change: Box<dyn FnMut(LayoutUpdate) + Send>,
+}
+
+fn recompute_and_report(state: &mut LayoutWatcherData) {
+    let bbox = state
+        .geometries
+        .values()
+        .filter(|rect| rect.is_complete())
+        .copied()
+        .reduce(Rect::merge);
+    let Some(bbox) = bbox else {
+        return;
+    };
+
+    let target = state
+        .output_names
+        .iter()
+        .find(|(_, name)| **name == state.target_name)
+        .and_then(|(id, _)| state.geometries.get(id))
+        .copied()
+        .filter(|rect| rect.is_complete());
+
+    let update = LayoutUpdate { bbox, target };
+    if state.last_reported != Some(update) {
+        state.last_reported = Some(update);
+        (state.on_change)(update);
+    }
+}
+
+/// Runs forever on the calling thread, invoking `on_change` every time the
+/// global output layout changes in a way that affects where a position
+/// for `target_name` should land -- including the target not existing yet
+/// (nothing is called until it appears), appearing later, moving, being
+/// resized, or another output changing in a way that reshapes the
+/// bounding rectangle. Intended to run on a dedicated background thread;
+/// never returns except on an unrecoverable Wayland error.
+pub fn watch_layout(target_name: String, on_change: impl FnMut(LayoutUpdate) + Send + 'static) {
+    let conn = match Connection::connect_to_env() {
+        Ok(conn) => conn,
+        Err(err) => {
+            eprintln!("extest: could not connect to Wayland to watch outputs: {err}");
+            return;
+        }
+    };
+    let display = conn.display();
+    let mut queue = conn.new_event_queue();
+    let handle = queue.handle();
+    display.get_registry(&handle, ());
+
+    let mut data = LayoutWatcherData {
+        output_man: None,
+        names_by_global: HashMap::new(),
+        output_names: HashMap::new(),
+        geometries: HashMap::new(),
+        pending_outputs: Vec::new(),
+        target_name,
+        last_reported: None,
+        on_change: Box::new(on_change),
+    };
+
+    // One explicit roundtrip first (same two-step shape as get_axes_range)
+    // so the initial global burst is fully drained before checking whether
+    // the manager showed up at all -- blocking_dispatch alone can return
+    // after processing just the first available event, which isn't enough
+    // to tell "not advertised" apart from "advertised, just not seen yet".
+    if let Err(err) = queue.roundtrip(&mut data) {
+        eprintln!("extest: Wayland roundtrip error while watching outputs: {err}");
+        return;
+    }
+    if data.output_man.is_none() {
+        eprintln!(
+            "extest: compositor did not advertise zxdg_output_manager_v1 (version 3+); \
+             EXTEST_TARGET_OUTPUT will never recalibrate past its initial fallback size"
+        );
+    }
+
+    loop {
+        if let Err(err) = queue.blocking_dispatch(&mut data) {
+            eprintln!("extest: Wayland dispatch error while watching outputs: {err}");
+            return;
+        }
+    }
+}
+
+impl Dispatch<zxdg_output_v1::ZxdgOutputV1, ObjectId> for LayoutWatcherData {
+    fn event(
+        state: &mut Self,
+        _: &zxdg_output_v1::ZxdgOutputV1,
+        event: zxdg_output_v1::Event,
+        output_id: &ObjectId,
+        _: &Connection,
+        _: &QueueHandle<LayoutWatcherData>,
+    ) {
+        {
+            let rect = state.geometries.entry(output_id.clone()).or_default();
+            match event {
+                zxdg_output_v1::Event::LogicalPosition { x, y } => {
+                    rect.x = x;
+                    rect.y = y;
+                }
+                zxdg_output_v1::Event::LogicalSize { width, height } => {
+                    rect.width = width;
+                    rect.height = height;
+                }
+                _ => return,
+            }
+        }
+        recompute_and_report(state);
+    }
+}
+
+impl Dispatch<wl_output::WlOutput, ()> for LayoutWatcherData {
+    fn event(
+        state: &mut Self,
+        proxy: &wl_output::WlOutput,
+        event: wl_output::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<LayoutWatcherData>,
+    ) {
+        if let wl_output::Event::Name { name } = event {
+            state.output_names.insert(proxy.id(), name);
+            recompute_and_report(state);
+        }
+    }
+}
+
+delegate_noop!(LayoutWatcherData: ZxdgOutputManagerV1);
+impl Dispatch<wl_registry::WlRegistry, ()> for LayoutWatcherData {
+    fn event(
+        state: &mut Self,
+        registry: &wl_registry::WlRegistry,
+        event: wl_registry::Event,
+        _: &(),
+        _: &Connection,
+        handle: &QueueHandle<LayoutWatcherData>,
+    ) {
+        match event {
+            wl_registry::Event::Global {
+                name,
+                interface,
+                version,
+            } => {
+                if interface == wl_output::WlOutput::interface().name {
+                    let bind_version = version.min(wl_output::WlOutput::interface().version);
+                    let output: wl_output::WlOutput = registry.bind(name, bind_version, handle, ());
+                    state.names_by_global.insert(name, output.id());
+                    match &state.output_man {
+                        Some(man) => {
+                            man.get_xdg_output(&output, handle, output.id());
+                        }
+                        None => state.pending_outputs.push((name, output)),
+                    }
+                } else if interface == ZxdgOutputManagerV1::interface().name && version >= 3 {
+                    let bind_version = version.min(ZxdgOutputManagerV1::interface().version);
+                    let man: ZxdgOutputManagerV1 = registry.bind(name, bind_version, handle, ());
+                    for (_, output) in state.pending_outputs.drain(..) {
+                        man.get_xdg_output(&output, handle, output.id());
+                    }
+                    state.output_man = Some(man);
+                }
+            }
+            wl_registry::Event::GlobalRemove { name } => {
+                if let Some(id) = state.names_by_global.remove(&name) {
+                    state.geometries.remove(&id);
+                    state.output_names.remove(&id);
+                    recompute_and_report(state);
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn merge_side_by_side_matches_niri_bounding_rectangle() {
+        // DP-2 at (0,0) 5120x1440, steam at (5120,0) 2880x1800 -- the
+        // layout observed live this session.
+        let dp2 = Rect { x: 0, y: 0, width: 5120, height: 1440 };
+        let steam = Rect { x: 5120, y: 0, width: 2880, height: 1800 };
+        let bbox = dp2.merge(steam);
+        assert_eq!(bbox, Rect { x: 0, y: 0, width: 8000, height: 1800 });
+    }
+
+    #[test]
+    fn merge_is_commutative() {
+        let a = Rect { x: -100, y: 20, width: 300, height: 50 };
+        let b = Rect { x: 0, y: 0, width: 50, height: 50 };
+        assert_eq!(a.merge(b), b.merge(a));
+    }
+
+    #[test]
+    fn incomplete_rect_is_excluded_from_bbox() {
+        // A newly-bound output with only Name or only LogicalPosition
+        // seen so far, size still 0x0, must not corrupt the bounding
+        // rectangle before its LogicalSize arrives.
+        assert!(!Rect::default().is_complete());
+        assert!(Rect { x: 0, y: 0, width: 1, height: 1 }.is_complete());
+    }
+}
