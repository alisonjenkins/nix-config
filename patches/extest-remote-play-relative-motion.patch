+/// An output's position and size in the compositor's global (multi-monitor)
+/// coordinate space, in logical pixels -- what `xdg_output`'s
+/// `logical_position`/`logical_size` report.
+#[derive(Copy, Clone, Default, PartialEq, Eq, Debug)]
+pub struct Rect {
+    pub x: i32,
+    pub y: i32,
+    pub width: i32,
+    pub height: i32,
+}
+
+impl Rect {
+    fn is_complete(self) -> bool {
+        self.width > 0 && self.height > 0
+    }
+
+    /// The smallest rectangle containing both `self` and `other`. Same
+    /// semantics as niri's own `Rectangle::merge`, which is what
+    /// `global_bounding_rectangle()` folds over every enabled output with
+    /// to get the rectangle libinput's absolute-axis scaling lands on (see
+    /// `on_pointer_motion_absolute`'s fallback path in niri's
+    /// `src/input/mod.rs`) -- this has to match it exactly, or the mapping
+    /// in `lib.rs` computes the wrong offset.
+    #[must_use]
+    pub fn merge(self, other: Rect) -> Rect {
+        let x = self.x.min(other.x);
+        let y = self.y.min(other.y);
+        let right = (self.x + self.width).max(other.x + other.width);
+        let bottom = (self.y + self.height).max(other.y + other.height);
+        Rect {
+            x,
+            y,
+            width: right - x,
+            height: bottom - y,
+        }
+    }
+}
