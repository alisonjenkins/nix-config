+// -- Persistent target-output watcher, used only when EXTEST_TARGET_OUTPUT
+// is set. --
+//
+// get_axes_range() above is a one-shot snapshot: fine for the "largest
+// connected output" fallback, wrong for a specific named output that may
+// not exist yet (Remote Play's host process starts before the virtual
+// output it targets is enabled) or may still be at a stale size (the
+// output exists but hasn't been resized to the connecting client's panel
+// yet). uinput exposes no way to change an absolute axis's declared range
+// on a live device, so the fix is to keep watching and rebuild the whole
+// device whenever the target's actual logical size changes, rather than
+// calibrating once and hoping the timing worked out.
+
+struct TargetWatcherData {
+    output_man: Option<ZxdgOutputManagerV1>,
+    output_names: HashMap<ObjectId, String>,
+    // Compositors are free to send LogicalSize before Name for the same
+    // output during the initial burst; caching every size seen, keyed by
+    // output, means whichever event completes the match (either order)
+    // can still find it, instead of only ever checking on LogicalSize.
+    latest_sizes: HashMap<ObjectId, DisplaySize>,
+    pending_outputs: Vec<wl_output::WlOutput>,
+    target_name: String,
+    last_reported: Option<DisplaySize>,
+    on_change: Box<dyn FnMut(DisplaySize) + Send>,
+}
+
+fn maybe_report_target(state: &mut TargetWatcherData, output_id: &ObjectId) {
+    let is_target = state
+        .output_names
+        .get(output_id)
+        .is_some_and(|name| *name == state.target_name);
+    if !is_target {
+        return;
+    }
+    let Some(&size) = state.latest_sizes.get(output_id) else {
+        return;
+    };
+    if state.last_reported != Some(size) {
+        state.last_reported = Some(size);
+        (state.on_change)(size);
+    }
+}
+
+/// Runs forever on the calling thread, invoking `on_change` with the named
+/// output's current logical size every time it changes -- including the
+/// output not existing yet (nothing is called until it appears), appearing
+/// later, or being resized. Intended to be run on a dedicated background
+/// thread; never returns except on an unrecoverable Wayland error.
+pub fn watch_target_output(target_name: String, on_change: impl FnMut(DisplaySize) + Send + 'static) {
+    let conn = match Connection::connect_to_env() {
+        Ok(conn) => conn,
+        Err(err) => {
+            eprintln!("extest: could not connect to Wayland to watch outputs: {err}");
+            return;
+        }
+    };
+    let display = conn.display();
+    let mut queue = conn.new_event_queue();
+    let handle = queue.handle();
+    display.get_registry(&handle, ());
+
+    let mut data = TargetWatcherData {
+        output_man: None,
+        output_names: HashMap::new(),
+        latest_sizes: HashMap::new(),
+        pending_outputs: Vec::new(),
+        target_name,
+        last_reported: None,
+        on_change: Box::new(on_change),
+    };
+
+    // One explicit roundtrip first (same two-step shape as get_axes_range)
+    // so the initial global burst is fully drained before checking whether
+    // the manager showed up at all -- blocking_dispatch alone can return
+    // after processing just the first available event, which isn't enough
+    // to tell "not advertised" apart from "advertised, just not seen yet".
+    if let Err(err) = queue.roundtrip(&mut data) {
+        eprintln!("extest: Wayland roundtrip error while watching outputs: {err}");
+        return;
+    }
+    if data.output_man.is_none() {
+        eprintln!(
+            "extest: compositor did not advertise zxdg_output_manager_v1 (version 3+); \
+             EXTEST_TARGET_OUTPUT will never recalibrate past its initial fallback size"
+        );
+    }
+
+    loop {
+        if let Err(err) = queue.blocking_dispatch(&mut data) {
+            eprintln!("extest: Wayland dispatch error while watching outputs: {err}");
+            return;
+        }
+    }
+}
+
+impl Dispatch<zxdg_output_v1::ZxdgOutputV1, ObjectId> for TargetWatcherData {
+    fn event(
+        state: &mut Self,
+        _: &zxdg_output_v1::ZxdgOutputV1,
+        event: zxdg_output_v1::Event,
+        output_id: &ObjectId,
+        _: &Connection,
+        _: &QueueHandle<TargetWatcherData>,
+    ) {
+        let zxdg_output_v1::Event::LogicalSize { width, height } = event else {
+            return;
+        };
+        state
+            .latest_sizes
+            .insert(output_id.clone(), DisplaySize { width, height });
+        maybe_report_target(state, output_id);
+    }
+}
+
+impl Dispatch<wl_output::WlOutput, ()> for TargetWatcherData {
+    fn event(
+        state: &mut Self,
+        proxy: &wl_output::WlOutput,
+        event: wl_output::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<TargetWatcherData>,
+    ) {
+        if let wl_output::Event::Name { name } = event {
+            let output_id = proxy.id();
+            state.output_names.insert(output_id.clone(), name);
+            maybe_report_target(state, &output_id);
+        }
+    }
+}
+
+delegate_noop!(TargetWatcherData: ZxdgOutputManagerV1);
+impl Dispatch<wl_registry::WlRegistry, ()> for TargetWatcherData {
+    fn event(
+        state: &mut Self,
+        registry: &wl_registry::WlRegistry,
+        event: wl_registry::Event,
+        _: &(),
+        _: &Connection,
+        handle: &QueueHandle<TargetWatcherData>,
+    ) {
+        let wl_registry::Event::Global {
+            name,
+            interface,
+            version,
+        } = event
+        else {
+            return;
+        };
+
+        if interface == wl_output::WlOutput::interface().name {
+            let bind_version = version.min(wl_output::WlOutput::interface().version);
+            let output: wl_output::WlOutput = registry.bind(name, bind_version, handle, ());
+            match &state.output_man {
+                Some(man) => {
+                    man.get_xdg_output(&output, handle, output.id());
+                }
+                None => state.pending_outputs.push(output),
+            }
+        } else if interface == ZxdgOutputManagerV1::interface().name && version >= 3 {
+            let bind_version = version.min(ZxdgOutputManagerV1::interface().version);
+            let man: ZxdgOutputManagerV1 = registry.bind(name, bind_version, handle, ());
+            for output in state.pending_outputs.drain(..) {
+                man.get_xdg_output(&output, handle, output.id());
+            }
+            state.output_man = Some(man);
+        }
+    }
+}
