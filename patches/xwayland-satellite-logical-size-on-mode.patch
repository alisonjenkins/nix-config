 #[test]
+fn output_mode_change_forwards_new_logical_size_xdg() {
+    let (mut f, _) = TestFixture::new_with_compositor();
+    let man = f.enable_xdg_output();
+
+    let (output_obj, output) = f.new_output(0, 0);
+    let output_xdg = f.create_xdg_output(&man, output_obj.obj.clone());
+    f.run();
+
+    std::mem::take(&mut *output_xdg.data.events.lock().unwrap());
+
+    f.testwl.set_output_mode(&output, 1728, 1080);
+    f.run();
+    f.run();
+
+    let events = std::mem::take(&mut *output_xdg.data.events.lock().unwrap());
+    let found = events.iter().rev().find_map(|e| {
+        if let zxdg_output_v1::Event::LogicalSize { width, height } = e {
+            Some((*width, *height))
+        } else {
+            None
+        }
+    });
+    let (width, height) = found.expect("No LogicalSize event received on xdg output");
+    assert_eq!((width, height), (1728, 1080));
+}
