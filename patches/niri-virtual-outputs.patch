+                continue;
+            };
+            let refresh_rate = configured_refresh_rate(&wanted);
+            virt.refresh_rate = refresh_rate;
+
+            let mode = Mode {
+                size: (i32::from(wanted.width), i32::from(wanted.height)).into(),
+                refresh: i32::try_from(refresh_rate * 1000).unwrap_or(60_000),
+            };
