+            assert!(
+                textures.iter().any(|geo| {
+                    geo.loc.y + geo.size.h <= region.loc.y
+                        && geo.loc.x >= region.loc.x
+                        && geo.loc.x + geo.size.w <= region.loc.x + region.size.w
+                }),
