+
+    fn projection_for(niri: &Niri, source: &str) -> Projection {
+        niri.projection_state
+            .projections
+            .iter()
+            .find(|p| p.source == source && p.kind == ProjectionKind::Overview)
+            .unwrap_or_else(|| {
+                panic!(
+                    "no overview projection for {source}: {:?}",
+                    niri.projection_state.projections
+                )
+            })
+            .clone()
+    }
