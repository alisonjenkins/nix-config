+        let model = "virtual".to_string();
+        let serial = n.to_string();
+
+        let refresh = i32::try_from(refresh_rate * 1000).unwrap_or(60_000);
+
+        let output = Output::new(
+            connector.clone(),
+            PhysicalProperties {
+                size: (0, 0).into(),
+                subpixel: smithay::output::Subpixel::Unknown,
+                make: make.clone(),
+                model: model.clone(),
+                serial_number: serial.clone(),
