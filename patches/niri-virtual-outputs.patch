+                        .outputs
+                        .find(virt.output.user_data().get::<OutputName>()?)
+                        .is_some_and(|c| c.off);
+                    virtual_output_transition(virt.enabled, off).map(|on| (name.clone(), on))
+                })
+                .collect()
+        };
